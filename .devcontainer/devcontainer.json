{
    "name": "R Development",
    "image": "ghcr.io/rocker-org/devcontainer/r-ver:4",
    "features": {
        "ghcr.io/rocker-org/devcontainer-features/renv-cache:latest": {},
        "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
        "ghcr.io/tailscale/codespace/tailscale:latest": {},
        "ghcr.io/michidk/devcontainers-features/typst:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "REditorSupport.r", 
                "quarto.quarto",
                "tailscale.vscode-tailscale"
            ],
            "settings": {
                "r.plot.view": "httpgd",
                "r.bracketedPaste": true,
                "[r]": {
                    "editor.formatOnSave": true
                }
            }
        },
        "codespaces": {
            "openFiles": [
                "README.md",
                "R/main.R"
            ]
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libsecret-1-dev libsodium-dev && R -q -e \"if (!file.exists('renv.lock')) {renv::init()} else {print('renv already initialized.')}\"",
    "postStartCommand": "R -q -e \"renv::restore()\""
}
